  "description": "Dry-run reconciler for pi: classifies repository files against the principles-render stamp — ok / missing / user-modified — without writing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protokol11/agent-governance.git",
    "directory": "npm/pi-setup-upgrade"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "agent-governance",
    "setup-repo",
    "upgrade-repo",
    "reconciler",
    "dry-run"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
