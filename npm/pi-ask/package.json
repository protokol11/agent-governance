  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protokol11/agent-governance.git",
    "directory": "npm/pi-ask"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "agent-governance",
    "ask",
    "questionnaire",
    "tui",
    "human-in-the-loop"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
